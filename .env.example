# ================================
# Environment Variables Template
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Plane (multi-workspace) ---
PLANE_API_TOKEN=your_plane_api_token_here
PLANE_WORKSPACE_SLUG=agentbuilder
PLANE_WORKSPACE_SLUGS=agentbuilder
PLANE_PROJECT_SCOPE=all
PLANE_AUTO_DISCOVER_WORKSPACES=true
PLANE_PROJECT_ID=all

# --- GitHub ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your_username/ai-analytics-dashboard

# --- App Config ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Agent Defaults ---
AGENT_MODEL=claude-opus-4-5
AGENT_MAX_TOKENS=8192
EOD_PUSH_TIME=18:00
MEMORY_RETENTION_DAYS=30

# --- Per-Agent LLM Models (optional overrides) ---
ORCHESTRATOR_MODEL=claude-opus-4-5
BUILDER_MODEL=claude-opus-4-5
TESTER_MODEL=claude-sonnet-4-5
SPRINT_WATCHER_MODEL=claude-haiku-4-5
PLANE_AGENT_MODEL=claude-haiku-4-5
GIT_AGENT_MODEL=claude-haiku-4-5

# --- Fleet Supervisor ---
FLEET_AUTO_RESTART=true
FLEET_SUPERVISOR_INTERVAL=30
WATCHDOG_POLL_INTERVAL=15
SPRINT_WATCHER_INTERVAL=60
SPRINT_VERIFY_CLOSE_COOLDOWN=120
